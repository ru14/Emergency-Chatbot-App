# Runs the copilot on every boot and restarts it if it stops.
# Install on the Linode:  cp deploy/app.service /etc/systemd/system/copilot.service && systemctl daemon-reload && systemctl enable --now copilot
[Unit]
Description=Emergency Dispatch Copilot on port 80
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/copilot
Environment=HOME=/root
Environment=PORT=80
ExecStart=/root/.local/bin/uv run /root/copilot/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
