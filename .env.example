# uv run check.py copies this file to .env the first time it runs, and saves your key there.
# Fill in a block when you reach its lab. Leave the rest empty.
# No quotes around values. No comments at the end of a value line.
# .env is in .gitignore. Never commit it.

# Inference. Event staff give you the key. It starts with sk_aka_.
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
CHAT_MODEL=qwen3-8-27b
VISION_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=qwen3-embedding-8b

# Managed PostgreSQL. Copy host, port, and password from your database's connection details. Lab 03.
PGHOST=
PGPORT=
PGUSER=akmadmin
PGPASSWORD=
PGDATABASE=defaultdb
PGSSLMODE=require

# Object Storage. Lab 04. The bucket goes in Chicago, which offers the current endpoint type, E3.
OBJ_ENDPOINT=https://us-ord-10.linodeobjects.com
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Copilot. Set APP_PASSWORD to require a login (user name: dispatcher) before the app faces anyone else.
APP_PASSWORD=
AI_TIMEOUT=30
